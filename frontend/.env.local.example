# Backend URL used server-side in Next.js Route Handlers (never exposed to browser)
BACKEND_URL=http://localhost:8888

# WebSocket URL used by the browser socket.io client
# Must be prefixed with NEXT_PUBLIC_ to be available in the browser
NEXT_PUBLIC_WS_URL=http://localhost:8888

# Notes:
# - Frontend runs on port 3333: `npm run dev` / `npm run start`
# - Backend must be launched with PORT=8888: `PORT=8888 npm run start:dev`
